+/// A query prepared for scoring many stored envelopes: the zero-padded shifted copies of
+/// the query for every lag, laid out row by row (`m[t * stride + j] = q[t + lag_j]`), so
+/// each stored envelope is scored by one pass over its values with independent
+/// accumulators across lags.
+///
+/// Distances are bitwise identical to [`distance`]: each lag's products are added in
+/// ascending `t` from the same neutral element. Padded positions contribute products with
+/// zero, which leave a nonzero sum unchanged and can only change the sign of a zero sum,
+/// which does not change the distance.
+pub struct LagQuery {
+    n: usize,
+    lags: usize,
+    stride: usize,
+    m: Vec<f64>,
+}
+
+/// Lags scored per pass in [`LagQuery`]; the accumulators of one block stay in registers.
+const QUERY_BLOCK: usize = 16;
+/// Largest shifted-query matrix [`LagQuery::new`] builds (values); larger queries use
+/// [`distance`] directly.
+const MAX_QUERY_MATRIX: usize = 1 << 21;
+
+impl LagQuery {
+    /// None when the inputs are invalid for [`distance`] or the matrix would be too large.
+    pub fn new(q: &[f64], max_lag: usize) -> Option<Self> {
+        let n = q.len();
+        if n == 0 || max_lag >= n {
+            return None;
+        }
+        let lags = 2 * max_lag + 1;
+        let stride = lags.div_ceil(QUERY_BLOCK) * QUERY_BLOCK;
+        if n.checked_mul(stride)? > MAX_QUERY_MATRIX {
+            return None;
+        }
+        let mut m = vec![0.0; n * stride];
+        for t in 0..n {
+            for j in 0..lags {
+                let i = t as isize + j as isize - max_lag as isize;
+                if (0..n as isize).contains(&i) {
+                    m[t * stride + j] = q[i as usize];
+                }
+            }
+        }
+        Some(Self { n, lags, stride, m })
+    }
+
+    /// `distance(q, g, max_lag)` for the query this was built from.
+    pub fn distance(&self, g: &[f64]) -> Result<f64, SignalError> {
+        if g.len() != self.n {
+            return Err(SignalError::LengthMismatch);
+        }
+        let zero: f64 = std::iter::empty::<f64>().sum();
+        let mut best = f64::NEG_INFINITY;
+        for b0 in (0..self.stride).step_by(QUERY_BLOCK) {
+            let mut acc = [zero; QUERY_BLOCK];
+            for (row, &gt) in self.m.chunks_exact(self.stride).zip(g) {
+                let r: &[f64; QUERY_BLOCK] = row[b0..b0 + QUERY_BLOCK].try_into().unwrap();
+                for j in 0..QUERY_BLOCK {
+                    acc[j] += r[j] * gt;
+                }
+            }
+            for &s in acc.iter().take(self.lags.saturating_sub(b0)) {
+                best = best.max(s);
+            }
+        }
+        Ok(1.0 - best / self.n as f64)
+    }
+}
