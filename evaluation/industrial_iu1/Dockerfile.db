FROM morletdb-spike-db
# Pin the pgvector build: 0.8.7-1.pgdg12+2 depends on postgresql-17 (>> 17.12) and would silently
# upgrade the base image's PostgreSQL 17.6 (#512). The +1 build has no such constraint.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-17-pgvector=0.8.7-1.pgdg12+1 \
 && rm -rf /var/lib/apt/lists/* && test "$(pg_config --version)" = "PostgreSQL 17.6 (Debian 17.6-2.pgdg12+1)"
