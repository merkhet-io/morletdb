    "documentation": "https://geofon.gfz.de/waveform/webservices/fdsnws.php"
  },
  "network_citation": {
    "code": "CX",
    "name": "IPOC Seismic Network",
    "doi": "10.14470/PK615318",
    "citation": "GFZ German Research Centre for Geosciences; Institut des Sciences de l'Univers-Centre National de la Recherche CNRS-INSU (2006): IPOC Seismic Network. Integrated Plate boundary Observatory Chile - IPOC. Dataset/Seismic Network. https://doi.org/10.14470/PK615318",
    "access": "Open; network page lists no restricted CX stations. Terms/rights field: Unknown."
  },
  "streams": [
    {"network": "CX", "station": "PB01", "location": "", "channel": "HHZ"},
    {"network": "CX", "station": "PB02", "location": "", "channel": "HHZ"},
    {"network": "CX", "station": "PB08", "location": "", "channel": "HHZ"}
  ],
  "periods": [
    {"name": "reference-2024-03", "split": "reference",
     "start": "2024-03-04T00:00:00Z", "end": "2024-03-11T00:00:00Z"},
    {"name": "heldout-2024-05", "split": "heldout",
     "start": "2024-05-01T00:00:00Z", "end": "2024-05-06T12:00:00Z"}
  ],
  "catalog": {
    "provider": "USGS ANSS ComCat",
    "event_service": "https://earthquake.usgs.gov/fdsnws/event/1/query",
    "documentation": "https://earthquake.usgs.gov/fdsnws/event/1/",
    "queries": [
      {"name": "regional", "latitude": -20.8, "longitude": -69.5, "maxradiuskm": 400, "minmagnitude": 2.5},
      {"name": "global", "minmagnitude": 6.0}
    ]
  },
  "representation": {
    "extractor": "morlet-energy-lowrate-v1",
    "window_samples": 2048,
    "stride_samples": 512,
    "normalization": "zscore",
