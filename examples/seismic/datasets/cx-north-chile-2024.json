    "filter": {"type": "bandpass", "freqmin": 2.0, "freqmax": 10.0, "corners": 4, "zerophase": false},
    "method": "recursive_sta_lta",
    "sta_s": 1.0, "lta_s": 30.0, "on": 4.0, "off": 1.5,
    "min_duration_s": 1.0, "warmup_s": 120.0, "post_s": 60.0, "block_s": 600.0,
    "query_pre_s": 2.0
  },
  "association": {
    "version": "taup-window-v1",
    "model": "iasp91",
    "pre_p_s": 5.0, "post_s_s": 20.0,
    "teleseismic_post_p_s": 30.0
  }
